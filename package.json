{
  "name": "claude-discord-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Discord DM bridge to Claude Code CLI with long-lived token watchdog",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "better-sqlite3": "11.10.0",
    "discord.js": "14.26.3",
    "dotenv": "16.6.1",
    "pino": "9.14.0",
    "pino-pretty": "11.3.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.19.17",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
