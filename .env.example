# claude-discord-bridge — env template. Copy to .env and fill in real values.

# Long-lived Claude Code auth token (from `claude setup-token` on any device with a browser)
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...

# Discord bot credentials (https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=
OWNER_DISCORD_ID=

# Optional
CLAUDE_BIN=/usr/local/bin/claude
POLL_INTERVAL_MS=600000
